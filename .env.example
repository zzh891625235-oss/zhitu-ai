# ============================================================
# 智途AI 环境变量示例
#
# 用法（任选其一）：
#   1. 直接设置系统环境变量（Windows: setx / macOS: export）
#   2. IDEA：Run → Edit Configurations → Environment variables 里逐条填写
#   3. 命令行启动前 export（见 README「快速开始」）
#
# 说明：Spring Boot 不自动读取 .env 文件，本文件仅作为变量清单参考。
#       有默认值的变量可以不配置，直接使用默认值即可跑通本地开发。
# ============================================================

# ---------- 服务端口 ----------
SERVER_PORT=8080

# ---------- 数据库 ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zhitu_ai
DB_USERNAME=root
DB_PASSWORD=123456

# ---------- AI 大模型 ----------
# 留空则后端进入「离线模板模式」：功能可用，但前端会标注结果非大模型生成
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT=60000
AI_MAX_RETRIES=2

# ---------- JWT ----------
# 生产环境务必替换为随机长字符串
JWT_SECRET=zhitu-ai-jwt-secret-key-2024-please-change-in-production
JWT_EXPIRATION=86400000

# ---------- 日志 ----------
# 需要看 SQL 时保持默认；生产环境建议改为
# org.apache.ibatis.logging.nologging.NoLoggingImpl
SQL_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl
