# ============================================================
# 智途AI · 环境变量模板（环境变量模板 = 变量名清单，不含任何真实密钥）
#
# 用法（任选其一）：
#   1. 复制本文件为 .env 自行填写（.env 已被 .gitignore 忽略，绝不会进仓库）
#   2. Windows: setx AI_API_KEY xxx   /  PowerShell: $env:AI_API_KEY="xxx"
#   3. macOS / Linux: export AI_API_KEY=xxx
#   4. IDEA: Run -> Edit Configurations -> Environment variables 逐条填写
#   5. Docker Compose: 在项目根目录放置 .env，compose 会自动读取
#
# 说明：Spring Boot 不自动读取 .env，本文件是变量清单参考；
#       所有变量均有默认值，不配置也能完整跑通演示（AI 走本地规则编排）。
# 安全：API Key / JWT 密钥 / 数据库密码一律通过环境变量注入，
#       严禁写入 application*.yml 或提交到公开仓库。
# ============================================================

# ---------- 服务 ----------
SERVER_PORT=8080
# demo = 内嵌 H2（免安装数据库）；留空或 prod = MySQL / 分布式数据库
SPRING_PROFILES_ACTIVE=demo

# ---------- 数据库（仅 MySQL 档位需要）----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zhitu_ai
DB_USERNAME=root
DB_PASSWORD=CHANGE_ME_DO_NOT_COMMIT

# ---------- AI 大模型 ----------
# 留空则进入「离线模板/规则编排」模式：功能可用，前端如实标注非大模型输出
AI_PROVIDER=deepseek
AI_API_KEY=
AI_API_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_TIMEOUT=60000
AI_MAX_RETRIES=2
# 视觉模型（证书拍照录入）；留空时回退 AI_MODEL，不支持视觉则降级为手动填写
AI_VISION_MODEL=
AI_MAX_IMAGE_MB=5

# ---------- 认证 ----------
# 生产环境务必替换为随机长字符串（本值仅为占位示例）
JWT_SECRET=CHANGE_ME_RANDOM_LONG_STRING
JWT_EXPIRATION=86400000

# ---------- 日志 ----------
SQL_LOG_IMPL=org.apache.ibatis.logging.stdout.StdOutImpl

# ---------- MCP Server（可选，仅 mcp-server/ 使用）----------
ZHITU_BASE_URL=http://localhost:8080
ZHITU_TOKEN=
